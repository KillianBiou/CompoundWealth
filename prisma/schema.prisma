generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String?
  age          Int?
  job          String?
  salaryCents  Int?
  currency     String    @default("EUR")
  numberLocale  String    @default("fr")
  createdAt    DateTime  @default(now())
  envelopes    Envelope[]
}

model Envelope {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          EnvelopeType
  name          String
  broker        String?
  openedAt      DateTime?
  closedAt      DateTime?
  depositsCents Int?
  createdAt   DateTime           @default(now())
  lastPriceRefreshAt DateTime?
  interestRate  Float?
  inflationRate Float?
  positions   Position[]
  valuations  EnvelopeValuation[]
  dcaPlans    DcaPlan[]
  deposits    EnvelopeDeposit[]

  @@index([userId])
}

enum EnvelopeType {
  PEA
  CTO
  LIVRET_A
  PRIV
}

enum DcaFrequency {
  BIWEEKLY
  MONTHLY
  BIMONTHLY
  QUARTERLY
}

model Position {
  id             String              @id @default(cuid())
  envelopeId     String
  envelope       Envelope            @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  name           String
  symbol          String?
  category       PositionCategory
  investedCents  Int?
  quantity       Float?
  unitPriceCents Int?
  notes          String?
  boughtAt       DateTime
  createdAt      DateTime            @default(now())
  valuations     PositionValuation[]
  investments   PositionInvestment[]
  cashIncomes    CashIncome[]

  @@index([envelopeId])
}

enum PositionCategory {
  ETF
  STOCK
  BOND
  FUND
  OTHER
}

model EnvelopeValuation {
  id         String   @id @default(cuid())
  envelopeId String
  envelope   Envelope @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  date       DateTime
  valueCents Int

  @@unique([envelopeId, date])
  @@index([envelopeId])
}

model PositionValuation {
  id         String   @id @default(cuid())
  positionId String
  position   Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  date       DateTime
  valueCents Int
  source     String?

  @@unique([positionId, date])
  @@index([positionId])
}

model PositionInvestment {
  id          String   @id @default(cuid())
  positionId  String
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  date        DateTime
  amountCents Int

  @@index([positionId])
}

model CashIncome {
  id          String   @id @default(cuid())
  positionId  String
  position    Position @relation(fields: [positionId], references: [id], onDelete: Cascade)
  date        DateTime
  /** montant net reçu en centimes (dividende, intérêt) */
  amountCents Int
  /** DIVIDEND, INTEREST_PAYMENT, ... */
  kind        String
  @@index([positionId])
}

model DcaPlan {
  id         String       @id @default(cuid())
  envelopeId String
  envelope   Envelope     @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  frequency  DcaFrequency
  startDate  DateTime
  active     Boolean      @default(true)
  createdAt  DateTime     @default(now())
  lines      DcaLine[]

  @@index([envelopeId])
}

model DcaLine {
  id             String   @id @default(cuid())
  planId         String
  plan           DcaPlan  @relation(fields: [planId], references: [id], onDelete: Cascade)
  isin           String
  name           String
  maxAmountCents Int
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([planId])
}

model EnvelopeDeposit {
  id          String    @id @default(cuid())
  envelopeId  String
  envelope    Envelope  @relation(fields: [envelopeId], references: [id], onDelete: Cascade)
  date        DateTime
  amountCents Int
  createdAt   DateTime  @default(now())

  @@index([envelopeId])
}
